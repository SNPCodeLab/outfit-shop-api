-- Select all products (excluding soft-deleted)
SELECT
    product_id,
    product_name,
    brand,
    product_type,
    gender,
    category_id,
    brand_id,
    material_fabric,
    season_collection,
    featured_badge,
    status,
    image_url,
    created_at
FROM products
WHERE deleted_at IS NULL
ORDER BY created_at DESC;



-- Soft delete: marks as deleted without removing the row
UPDATE products
SET deleted_at = NOW()
WHERE product_id = 1;


