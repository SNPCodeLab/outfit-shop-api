APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────
# DATABASE ENGINE — PRIMARY: PostgreSQL (Neon Cloud)
# Active production database. Use pgsql for all deployments.
# ─────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ssmis_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here
DB_SSLMODE=prefer

# ─────────────────────────────────────────────────────
# ALTERNATIVE ENGINE: Oracle SQL (on-premise enterprise)
# Switch DB_CONNECTION=oracle for Oracle deployments.
# Requires yajra/laravel-oracle package (already in composer.json).
# ─────────────────────────────────────────────────────
# DB_CONNECTION=oracle
# DB_HOST=127.0.0.1
# DB_PORT=1521
# DB_DATABASE=XE
# DB_USERNAME=ssmis_user
# DB_PASSWORD=your_oracle_password_here
# DB_SERVICE_NAME=XE

# ─────────────────────────────────────────────────────
# LOCAL TESTING ONLY: SQLite (no server required)
# ─────────────────────────────────────────────────────
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Production target: Redis for the >85% cache-hit-ratio KPI. Falls back to
# the database store when Redis is not provisioned on a host.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────────────────
# CLOUDINARY IMAGE STORAGE & CDN
# ─────────────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://292517627621863:your_api_secret_here@od8t271n
CLOUDINARY_CLOUD_NAME=od8t271n
CLOUDINARY_API_KEY=292517627621863
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_FOLDER=khmeriel/products

VITE_APP_NAME="${APP_NAME}"
