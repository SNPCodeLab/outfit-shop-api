{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public/build",
  "cleanUrls": false,
  "routes": [
    {
      "src": "/api",
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
