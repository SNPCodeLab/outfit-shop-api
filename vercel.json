{
  "version": 2,
  "buildCommand": "echo 'skipping npm build'",
  "installCommand": "echo 'skipping npm install'",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "env": {
    "VERCEL_PHP_VERSION": "8.3"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
