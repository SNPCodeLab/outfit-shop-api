{
  "info": {
    "_postman_id": "ssmis-complete-v2",
    "name": "SS-MIS API — Complete Collection v2",
    "description": "Complete Postman Collection for SS-MIS (Store Stock & Point-of-Sale Information System).\n\n🔧 LOCAL: http://localhost:8000/api\n🌐 PROD:  https://api.kesararamwithdigital.tech/api\n\n📋 HOW TO USE:\n1. Set base_url variable to http://localhost:8000/api\n2. Run any Login request — token is auto-saved to {{auth_token}}\n3. All protected requests use {{auth_token}} automatically\n\n👤 DEFAULT ACCOUNTS:\n  ADMIN   → username: admin   / Admin@123456\n  MANAGER → username: manager / Manager@123456\n  CASHIER → username: cashier / Cashier@123456",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string",
      "description": "Change to https://api.kesararamwithdigital.tech/api for production"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string",
      "description": "Auto-filled by the Login request test script"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as ADMIN",
          "event": [{"listen": "test","script": {"exec": ["var res = pm.response.json();","if (res.data && res.data.access_token) {","    pm.collectionVariables.set('auth_token', res.data.access_token);","    console.log('Token saved: ADMIN');","}"],"type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type","value": "application/json"},{"key": "Accept","value": "application/json"}],
            "body": {"mode": "raw","raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123456\"\n}"},
            "url": {"raw": "{{base_url}}/v1/auth/login","host": ["{{base_url}}"],"path": ["v1","auth","login"]},
            "description": "ADMIN role. Full access to everything including employee management."
          }
        },
        {
          "name": "Login as MANAGER",
          "event": [{"listen": "test","script": {"exec": ["var res = pm.response.json();","if (res.data && res.data.access_token) {","    pm.collectionVariables.set('auth_token', res.data.access_token);","    console.log('Token saved: MANAGER');","}"],"type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type","value": "application/json"},{"key": "Accept","value": "application/json"}],
            "body": {"mode": "raw","raw": "{\n  \"username\": \"manager\",\n  \"password\": \"Manager@123456\"\n}"},
            "url": {"raw": "{{base_url}}/v1/auth/login","host": ["{{base_url}}"],"path": ["v1","auth","login"]},
            "description": "MANAGER role. Can manage catalog, inventory, purchases, suppliers, void sales, see dashboard & audit logs."
          }
        },
        {
          "name": "Login as CASHIER",
          "event": [{"listen": "test","script": {"exec": ["var res = pm.response.json();","if (res.data && res.data.access_token) {","    pm.collectionVariables.set('auth_token', res.data.access_token);","    console.log('Token saved: CASHIER');","}"],"type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type","value": "application/json"},{"key": "Accept","value": "application/json"}],
            "body": {"mode": "raw","raw": "{\n  \"username\": \"cashier\",\n  \"password\": \"Cashier@123456\"\n}"},
            "url": {"raw": "{{base_url}}/v1/auth/login","host": ["{{base_url}}"],"path": ["v1","auth","login"]},
            "description": "CASHIER role. Can read catalog, register customers, do POS checkout, view sales."
          }
        },
        {
          "name": "Get My Profile (me)",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept","value": "application/json"},{"key": "Authorization","value": "Bearer {{auth_token}}"}],
            "url": {"raw": "{{base_url}}/v1/auth/me","host": ["{{base_url}}"],"path": ["v1","auth","me"]},
            "description": "Returns authenticated user profile, role and full permissions list."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept","value": "application/json"},{"key": "Authorization","value": "Bearer {{auth_token}}"}],
            "url": {"raw": "{{base_url}}/v1/auth/logout","host": ["{{base_url}}"],"path": ["v1","auth","logout"]}
          }
        },
        {
          "name": "Register User Account [ADMIN ONLY]",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type","value": "application/json"},{"key": "Accept","value": "application/json"},{"key": "Authorization","value": "Bearer {{auth_token}}"}],
            "body": {"mode": "raw","raw": "{\n  \"name\": \"New Team Member\",\n  \"email\": \"newmember@ssmis.local\",\n  \"password\": \"Secret@123456\",\n  \"password_confirmation\": \"Secret@123456\",\n  \"role\": \"cashier\"\n}"},
            "url": {"raw": "{{base_url}}/v1/auth/register","host": ["{{base_url}}"],"path": ["v1","auth","register"]},
            "description": "ADMIN ONLY. Creates a User model account (not Employee). Role options: admin, manager, cashier, staff, viewer."
          }
        }
      ]
    },
