{
  "info": {
    "_postman_id": "khmeriel-ssmis-master-api-v1",
    "name": "KhmeRiel MIS & POS — Master API Collection (All 4 RBAC Levels)",
    "description": "Complete Postman collection for KhmeRiel / CSMS Store Stock & Point-of-Sale API with all 4 RBAC levels (Public, Cashier/Staff, Manager, Admin), 10% Tax calculation, and Broadcast Messaging.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.kesararamwithdigital.tech/api/v1",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "manager_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "cashier_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "staff_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Level 1: Public & Guest (Storefront & Catalog)",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "System Status & Logo",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/status", "host": ["{{base_url}}"], "path": ["status"] }
          }
        },
        {
          "name": "POS Audio Cue Sounds",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/settings/audio-cues", "host": ["{{base_url}}"], "path": ["settings", "audio-cues"] }
          }
        },
        {
          "name": "Staff / Admin Login (Get Sanctum Token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@ssmis.local\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] }
          }
        },
        {
          "name": "Get All Brands",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/brands", "host": ["{{base_url}}"], "path": ["brands"] }
          }
        },
        {
          "name": "Get Clothing Sizes",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/clothing-sizes", "host": ["{{base_url}}"], "path": ["clothing-sizes"] }
          }
        },
        {
          "name": "Get Colors & Hex Swatches",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/colors", "host": ["{{base_url}}"], "path": ["colors"] }
          }
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] }
          }
        },
        {
          "name": "Get Single Product with Variants",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products/19", "host": ["{{base_url}}"], "path": ["products", "19"] }
          }
        },
        {
          "name": "Get Product 2D Variant Matrix",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/products/19/matrix", "host": ["{{base_url}}"], "path": ["products", "19", "matrix"] }
          }
        },
        {
          "name": "Get Marketing Banners",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/marketing/banners", "host": ["{{base_url}}"], "path": ["marketing", "banners"] }
          }
        },
        {
          "name": "Get Active Promotions",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/promotions/active", "host": ["{{base_url}}"], "path": ["promotions", "active"] }
          }
        }
      ]
    },
    {
      "name": "Level 2: Cashier & Staff (POS Checkout, Shifts & Scanning)",
      "item": [
        {
          "name": "Live Role-Pulse Analytics (Pie & Agile Graph)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashier_token}}" }],
            "url": { "raw": "{{base_url}}/dashboard/role-pulse", "host": ["{{base_url}}"], "path": ["dashboard", "role-pulse"] }
          }
        },
        {
          "name": "Get Active Broadcast Alerts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashier_token}}" }],
            "url": { "raw": "{{base_url}}/alerts/active", "host": ["{{base_url}}"], "path": ["alerts", "active"] }
          }
        },
        {
          "name": "Scan Barcode Lookup",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashier_token}}" }],
            "url": { "raw": "{{base_url}}/variants/barcode/885000001901", "host": ["{{base_url}}"], "path": ["variants", "barcode", "885000001901"] }
          }
        },
        {
          "name": "Get Low Stock Variants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staff_token}}" }],
            "url": { "raw": "{{base_url}}/variants/low-stock?threshold=10", "host": ["{{base_url}}"], "path": ["variants", "low-stock"] }
          }
        },
        {
          "name": "Open Cash Drawer Shift",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashier_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"opening_float_usd\": 100.00,\n  \"opening_float_khr\": 400000.00\n}"
            },
            "url": { "raw": "{{base_url}}/shifts/open", "host": ["{{base_url}}"], "path": ["shifts", "open"] }
          }
        },
        {
          "name": "POS Sale Checkout (10% Tax-Exclusive)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashier_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 1,\n  \"payment_method\": \"ABA\",\n  \"payment_amount\": 74.25,\n  \"overall_discount\": 0.00,\n  \"tax_rate\": 10.00,\n  \"items\": [\n    {\n      \"variant_id\": 1,\n      \"quantity\": 1,\n      \"discount\": 0.00\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/sales/checkout", "host": ["{{base_url}}"], "path": ["sales", "checkout"] }
          }
        },
        {
          "name": "Get Thermal Receipt (ESC/POS)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashier_token}}" }],
            "url": { "raw": "{{base_url}}/sales/1/receipt-thermal", "host": ["{{base_url}}"], "path": ["sales", "1", "receipt-thermal"] }
          }
        },
        {
          "name": "Generate Dynamic KHQR Payment Code",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashier_token}}" }],
            "url": { "raw": "{{base_url}}/sales/1/khqr", "host": ["{{base_url}}"], "path": ["sales", "1", "khqr"] }
          }
        },
        {
          "name": "Close Shift & Print Z-Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashier_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"closing_cash_usd\": 1845.00,\n  \"notes\": \"Evening shift closed successfully\"\n}"
            },
            "url": { "raw": "{{base_url}}/shifts/close", "host": ["{{base_url}}"], "path": ["shifts", "close"] }
          }
        },
        {
          "name": "Customer Search by Phone",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{cashier_token}}" }],
            "url": { "raw": "{{base_url}}/customers?search=012888999", "host": ["{{base_url}}"], "path": ["customers"] }
          }
        },
        {
          "name": "Register New Customer at POS",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{cashier_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Molyka Seng\",\n  \"phone\": \"012999111\",\n  \"gender\": \"Female\",\n  \"email\": \"molyka@gmail.com\"\n}"
            },
            "url": { "raw": "{{base_url}}/customers", "host": ["{{base_url}}"], "path": ["customers"] }
          }
        }
      ]
    },
