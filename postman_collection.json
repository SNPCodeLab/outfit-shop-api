            ],
            "url": { "raw": "{{base_url}}/purchases/auto-generate", "host": ["{{base_url}}"], "path": ["purchases", "auto-generate"] }
          }
        },
        {
          "name": "Get Cloudinary Media Gallery",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{manager_token}}" }],
            "url": { "raw": "{{base_url}}/uploads/gallery", "host": ["{{base_url}}"], "path": ["uploads", "gallery"] }
          }
        }
      ]
