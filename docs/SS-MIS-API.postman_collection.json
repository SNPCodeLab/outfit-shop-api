{
  "info": {
    "_postman_id": "ssmis-api-collection-v1",
    "name": "SS-MIS API — Store Stock & POS",
    "description": "Complete REST API collection for the Store Stock & Point-of-Sale Management Information System.\n\n**Access Tiers**\n- 🌐 PUBLIC — No token required\n- 🔑 AUTH — Any valid Bearer token\n- 🔒 MANAGER — Role: MANAGER or ADMIN\n- 👑 ADMIN — Role: ADMIN only\n\n**Auto-Token:** Login runs a test script that saves `access_token` to the environment automatically. All protected requests use `{{access_token}}`.\n\n**Environments:** Switch between `Local` and `Production` using the environment selector.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
