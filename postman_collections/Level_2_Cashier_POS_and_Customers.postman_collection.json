{
  "info": {
    "name": "Level 2 - Cashier (POS Sales & Customers)",
    "_postman_id": "ssmis-level-2-cashier",
    "description": "Cashier operations for POS sales checkout and customer relationship management.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "2.1 View Current User Profile (Me)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/me"
      }
    },
    {
      "name": "2.2 List Customers",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/customers"
      }
    },
    {
      "name": "2.3 Get Customer by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/customers/1"
      }
    },
    {
      "name": "2.4 Register New Customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Chanthy Kim\",\n  \"gender\": \"Female\",\n  \"phone\": \"+85512778899\",\n  \"email\": \"chanthy@example.com\",\n  \"address\": \"Tuol Kork, Phnom Penh\"\n}"
        },
        "url": "{{base_url}}/api/v1/customers"
      }
    },
    {
      "name": "2.5 Update Customer Details",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Chanthy Kim Updated\",\n  \"phone\": \"+85512778800\",\n  \"address\": \"Boeung Keng Kang, Phnom Penh\"\n}"
        },
        "url": "{{base_url}}/api/v1/customers/1"
      }
    },
    {
      "name": "2.6 POS Sales Checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": 1,\n  \"payment_method\": \"CASH\",\n  \"items\": [\n    {\n      \"variant_id\": 1,\n      \"quantity\": 2,\n      \"unit_price\": 35.00,\n      \"discount_amount\": 0.00\n    }\n  ],\n  \"paid_amount\": 70.00\n}"
        },
        "url": "{{base_url}}/api/v1/sales/checkout"
      }
    },
    {
      "name": "2.7 List Sales Invoices",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/sales"
      }
    },
    {
      "name": "2.8 Get Sale Invoice Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/sales/1"
      }
    },
    {
      "name": "2.9 Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/logout"
