{
  "info": {
    "name": "Level 1 - Public Catalog & Authentication",
    "_postman_id": "ssmis-level-1-public",
    "description": "Public read-only catalog and authentication login endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1.1 Login (Auto-Saves Bearer Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.access_token) {",
              "    pm.collectionVariables.set('token', jsonData.data.access_token);",
              "    pm.environment.set('token', jsonData.data.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"your_username_here\",\n  \"password\": \"your_password_here\"\n}"
        },
        "url": "{{base_url}}/api/v1/auth/login"
      }
    },
    {
      "name": "1.2 List Categories",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/categories"
